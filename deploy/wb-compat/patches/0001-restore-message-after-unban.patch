diff --git a/app/events/admin_restore.go b/app/events/admin_restore.go
new file mode 100644
index 0000000000000000000000000000000000000000..920f83f9a5aae6a474e9e9cbb4aecb6a6c4062cc
--- /dev/null
+++ b/app/events/admin_restore.go
@@ -0,0 +1,53 @@
+package events
+
+import (
+	"fmt"
+	"log"
+	"strconv"
+	"unicode/utf16"
+
+	tbapi "github.com/OvyFlash/telegram-bot-api"
+)
+
+// restoreMessage reposts the text of a wrongly banned message to the primary chat once an admin
+// unbans its author: the ban deleted the message, and without the repost the author has to notice
+// that and write it again. report is the admin chat ban report the unban button belongs to, as
+// telegram returns it on the callback. disabled when restoreMsg is empty; training and dry modes
+// never delete the message, so there is nothing to restore there.
+//
+// the text is sent with an entity instead of a parse mode, so neither the author's name nor the
+// message needs escaping
+func (a *admin) restoreMessage(userID int64, report string) error {
+	if a.restoreMsg == "" || a.trainingMode || a.dry {
+		return nil
+	}
+	text, err := a.getCleanMessage(report)
+	if err != nil || text == "" {
+		return nil // a ban without a message, e.g. a reaction spammer, has nothing to restore
+	}
+	name, err := a.extractUsername(report)
+	if err != nil || name == "" {
+		name = strconv.FormatInt(userID, 10)
+	}
+
+	msg := tbapi.NewMessage(a.primChatID, name+", "+a.restoreMsg+"\n\n"+text)
+	msg.LinkPreviewOptions = tbapi.LinkPreviewOptions{IsDisabled: true}
+	if userID > 0 { // a channel has no user to mention
+		msg.Entities = []tbapi.MessageEntity{{Type: "text_mention", Offset: 0,
+			Length: len(utf16.Encode([]rune(name))), User: &tbapi.User{ID: userID}}}
+	}
+	if _, err = a.tbAPI.Send(msg); err == nil {
+		return nil
+	}
+	if len(msg.Entities) == 0 {
+		return fmt.Errorf("failed to repost the message of unbanned user %d: %w", userID, err)
+	}
+
+	// telegram refuses a mention of a user it does not let the bot see; the text matters more
+	log.Printf("[WARN] failed to repost the message of unbanned user %d with a mention, retrying without: %v", userID, err)
+	msg.Entities = nil
+	if _, err = a.tbAPI.Send(msg); err != nil {
+		return fmt.Errorf("failed to repost the message of unbanned user %d: %w", userID, err)
+	}
+	return nil
+}
diff --git a/app/events/admin_restore_test.go b/app/events/admin_restore_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..08ceafebbd8fa2821a9fc5e744e217ce321bf499
--- /dev/null
+++ b/app/events/admin_restore_test.go
@@ -0,0 +1,152 @@
+package events
+
+import (
+	"context"
+	"testing"
+
+	tbapi "github.com/OvyFlash/telegram-bot-api"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/umputun/tg-spam/app/events/mocks"
+	"github.com/umputun/tg-spam/app/storage"
+)
+
+const testRestoreMsg = "прошу прощения, принял вас за спамера. Вот ваше сообщение"
+
+// newRestoreAdmin returns an admin in soft-ban mode wired to mocks, with the primary chat 123 and
+// the admin chat 456; sendErr decides the outcome of every send to the primary chat
+func newRestoreAdmin(restoreMsg string, sendErr func(tbapi.MessageConfig) error) (*admin, *mocks.TbAPIMock) {
+	mockAPI := &mocks.TbAPIMock{
+		SendFunc: func(c tbapi.Chattable) (tbapi.Message, error) {
+			if mc, ok := c.(tbapi.MessageConfig); ok && mc.ChatID == 123 && sendErr != nil {
+				return tbapi.Message{}, sendErr(mc)
+			}
+			return tbapi.Message{}, nil
+		},
+		RequestFunc: func(c tbapi.Chattable) (*tbapi.APIResponse, error) { return &tbapi.APIResponse{Ok: true}, nil },
+	}
+	adm := &admin{
+		tbAPI: mockAPI,
+		bot: &mocks.BotMock{
+			UpdateHamFunc:       func(msg string) error { return nil },
+			AddApprovedUserFunc: func(id int64, name string) error { return nil },
+		},
+		locator: &mocks.LocatorMock{
+			SpamFunc: func(ctx context.Context, userID int64) (storage.SpamData, bool) { return storage.SpamData{}, false },
+		},
+		primChatID: 123, adminChatID: 456, softBan: true, restoreMsg: restoreMsg,
+	}
+	return adm, mockAPI
+}
+
+func unbanQuery(data, report string) *tbapi.CallbackQuery {
+	return &tbapi.CallbackQuery{
+		ID:      "test-callback-id",
+		Data:    data,
+		Message: &tbapi.Message{MessageID: 789, Chat: tbapi.Chat{ID: 456}, Text: report},
+		From:    &tbapi.User{UserName: "admin", ID: 111},
+	}
+}
+
+// reposts returns the messages sent to the primary chat
+func reposts(mockAPI *mocks.TbAPIMock) (res []tbapi.MessageConfig) {
+	for _, call := range mockAPI.SendCalls() {
+		if mc, ok := call.C.(tbapi.MessageConfig); ok && mc.ChatID == 123 {
+			res = append(res, mc)
+		}
+	}
+	return res
+}
+
+func TestAdmin_callbackUnbanConfirmedRestore(t *testing.T) {
+	t.Run("reposts the original text addressed to its author", func(t *testing.T) {
+		adm, mockAPI := newRestoreAdmin(testRestoreMsg, nil)
+		query := unbanQuery("777:999", "restricted Иван_Петров (777)\n\nwhere do I buy a relay_module *now*?")
+		require.NoError(t, adm.callbackUnbanConfirmed(query))
+
+		sent := reposts(mockAPI)
+		require.Len(t, sent, 1)
+		assert.Equal(t, "Иван_Петров, "+testRestoreMsg+"\n\nwhere do I buy a relay_module *now*?", sent[0].Text,
+			"the text goes out as is, nothing escaped")
+		assert.Empty(t, sent[0].ParseMode)
+		require.Len(t, sent[0].Entities, 1)
+		ent := sent[0].Entities[0]
+		assert.Equal(t, "text_mention", ent.Type)
+		assert.Equal(t, 0, ent.Offset)
+		assert.Equal(t, 11, ent.Length, "length in utf-16 units of the name")
+		require.NotNil(t, ent.User)
+		assert.Equal(t, int64(777), ent.User.ID)
+	})
+
+	t.Run("names a channel without a mention", func(t *testing.T) {
+		adm, mockAPI := newRestoreAdmin(testRestoreMsg, nil)
+		require.NoError(t, adm.callbackUnbanConfirmed(unbanQuery("-100123:999", "restricted Spam Channel (-100123)\n\nchannel post")))
+
+		sent := reposts(mockAPI)
+		require.Len(t, sent, 1)
+		assert.Equal(t, "Spam Channel, "+testRestoreMsg+"\n\nchannel post", sent[0].Text)
+		assert.Empty(t, sent[0].Entities)
+	})
+
+	t.Run("falls back to the user id when the report has no name", func(t *testing.T) {
+		adm, mockAPI := newRestoreAdmin(testRestoreMsg, nil)
+		require.NoError(t, adm.callbackUnbanConfirmed(unbanQuery("777:999", "some report line\n\nhello there")))
+
+		sent := reposts(mockAPI)
+		require.Len(t, sent, 1)
+		assert.Equal(t, "777, "+testRestoreMsg+"\n\nhello there", sent[0].Text)
+	})
+
+	t.Run("retries without the mention when telegram refuses it", func(t *testing.T) {
+		adm, mockAPI := newRestoreAdmin(testRestoreMsg, func(mc tbapi.MessageConfig) error {
+			if len(mc.Entities) > 0 {
+				return assert.AnError
+			}
+			return nil
+		})
+		require.NoError(t, adm.callbackUnbanConfirmed(unbanQuery("777:999", "restricted Ivan (777)\n\nhello")))
+
+		sent := reposts(mockAPI)
+		require.Len(t, sent, 2)
+		assert.NotEmpty(t, sent[0].Entities)
+		assert.Empty(t, sent[1].Entities)
+		assert.Equal(t, sent[0].Text, sent[1].Text)
+	})
+
+	t.Run("reports a repost that fails after the unban", func(t *testing.T) {
+		adm, mockAPI := newRestoreAdmin(testRestoreMsg, func(tbapi.MessageConfig) error { return assert.AnError })
+		err := adm.callbackUnbanConfirmed(unbanQuery("777:999", "restricted Ivan (777)\n\nhello"))
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "unbanned user 777")
+
+		unbanned := false
+		for _, call := range mockAPI.RequestCalls() {
+			if _, ok := call.C.(tbapi.RestrictChatMemberConfig); ok {
+				unbanned = true
+			}
+		}
+		assert.True(t, unbanned, "the unban itself happens before the repost")
+	})
+
+	for _, tt := range []struct {
+		name               string
+		restoreMsg, report string
+		training, dry      bool
+	}{
+		{name: "disabled without a restore message", report: "restricted Ivan (777)\n\nhello"},
+		{name: "training mode never deleted the message", restoreMsg: testRestoreMsg, training: true,
+			report: "restricted Ivan (777)\n\nhello"},
+		{name: "dry mode never deleted the message", restoreMsg: testRestoreMsg, dry: true,
+			report: "restricted Ivan (777)\n\nhello"},
+		{name: "a ban without a message has nothing to restore", restoreMsg: testRestoreMsg,
+			report: "restricted Ivan (777) reaction spammer"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			adm, mockAPI := newRestoreAdmin(tt.restoreMsg, nil)
+			adm.trainingMode, adm.dry = tt.training, tt.dry
+			require.NoError(t, adm.callbackUnbanConfirmed(unbanQuery("777:999", tt.report)))
+			assert.Empty(t, reposts(mockAPI), "nothing may be posted to the primary chat")
+		})
+	}
+}
