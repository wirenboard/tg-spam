index 52c565d5be3a5e1be493347663d2431b32b2fb52..9590906ba9146b18bf48a97514e3a6e932eb503d 100644
--- a/app/events/admin.go
+++ b/app/events/admin.go
@@ -38,6 +38,7 @@ type admin struct {
 	softBan                bool // if true, the user not banned automatically, but only restricted
 	dry                    bool
 	warnMsg                string
+	restoreMsg             string // reposts the original text after an unban, disabled if empty
 	aggressiveCleanup      bool
 	aggressiveCleanupLimit int
 	warnings               Warnings      // storage for /warn records, used by DirectWarnReport auto-ban path
@@ -938,7 +939,8 @@ func (a *admin) callbackUnbanConfirmed(query *tbapi.CallbackQuery) error {
 	}
 
 	// get the original spam message to update ham samples
-	if cleanMsg, cleanErr := a.getCleanMessage(query.Message.Text); cleanErr == nil && cleanMsg != "" {
+	cleanMsg, cleanErr := a.getCleanMessage(query.Message.Text)
+	if cleanErr == nil && cleanMsg != "" {
 		// update ham samples if we have a clean message
 		if upErr := a.bot.UpdateHam(cleanMsg); upErr != nil {
 			return fmt.Errorf("failed to update ham for %q: %w", cleanMsg, upErr)
@@ -996,6 +998,28 @@ func (a *admin) callbackUnbanConfirmed(query *tbapi.CallbackQuery) error {
 	if err := send(editMsg, a.tbAPI); err != nil {
 		return fmt.Errorf("failed to edit message, chatID:%d, msgID:%d, %w", chatID, query.Message.MessageID, err)
 	}
+	return a.restoreMessage(userID, name, cleanMsg)
+}
+
+// restoreMessage reposts the text of a wrongly banned message to the primary chat, addressed to its
+// author, once an admin unbans the author: the ban deleted the message, and without the repost the
+// author has to notice that and write it again. disabled when restoreMsg is empty. training and dry
+// modes never delete the message, so there is nothing to restore there.
+func (a *admin) restoreMessage(userID int64, name, text string) error {
+	if a.restoreMsg == "" || text == "" || a.trainingMode || a.dry {
+		return nil
+	}
+	if name == "" {
+		name = fmt.Sprintf("%d", userID)
+	}
+	mention := fmt.Sprintf("[%s](tg://user?id=%d)", markdownV1LinkLabel(name), userID)
+	if userID < 0 { // tg://user links don't resolve channels
+		mention = escapeMarkDownV1Text(name)
+	}
+	restoreText := fmt.Sprintf("%s, %s\n\n%s", mention, escapeMarkDownV1Text(a.restoreMsg), escapeMarkDownV1Text(text))
+	if err := send(tbapi.NewMessage(a.primChatID, restoreText), a.tbAPI); err != nil {
+		return fmt.Errorf("failed to repost the message of unbanned user %d: %w", userID, err)
+	}
 	return nil
 }
 
diff --git a/app/events/admin_restore_test.go b/app/events/admin_restore_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..5542518c2eebaacc9a0ef91212cbc17624c7ab86
--- /dev/null
+++ b/app/events/admin_restore_test.go
@@ -0,0 +1,150 @@
+package events
+
+import (
+	"context"
+	"testing"
+
+	tbapi "github.com/OvyFlash/telegram-bot-api"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/umputun/tg-spam/app/events/mocks"
+	"github.com/umputun/tg-spam/app/storage"
+)
+
+func TestAdmin_callbackUnbanConfirmedRestore(t *testing.T) {
+	const restoreMsg = "прошу прощения, принял вас за спамера. Вот ваше сообщение"
+
+	tests := []struct {
+		name       string
+		restoreMsg string
+		training   bool
+		dry        bool
+		data       string // callback data, userID:msgID
+		report     string // admin chat report as telegram returns it on callback, markdown stripped
+		wantRepost bool
+		wantIn     []string
+		wantNotIn  []string
+	}{
+		{
+			name: "reposts the original text to its author", restoreMsg: restoreMsg,
+			data: "777:999", report: "restricted Ivan Petrov (777)\n\nwhere do I buy a relay_module?",
+			wantRepost: true,
+			wantIn:     []string{"[Ivan Petrov](tg://user?id=777), ", restoreMsg, "where do I buy a relay\\_module?"},
+		},
+		{
+			name: "names a channel without a user link", restoreMsg: restoreMsg,
+			data: "-100123:999", report: "restricted Spam Channel (-100123)\n\nchannel post text",
+			wantRepost: true,
+			wantIn:     []string{"Spam Channel, ", "channel post text"},
+			wantNotIn:  []string{"tg://user"},
+		},
+		{
+			name: "disabled without a restore message", restoreMsg: "",
+			data: "777:999", report: "restricted Ivan Petrov (777)\n\nwhere do I buy a relay?",
+		},
+		{
+			name: "training mode never deleted the message", restoreMsg: restoreMsg, training: true,
+			data: "777:999", report: "restricted Ivan Petrov (777)\n\nwhere do I buy a relay?",
+		},
+		{
+			name: "dry mode never deleted the message", restoreMsg: restoreMsg, dry: true,
+			data: "777:999", report: "restricted Ivan Petrov (777)\n\nwhere do I buy a relay?",
+		},
+		{
+			name: "no text to restore", restoreMsg: restoreMsg,
+			data: "777:0", report: "restricted Ivan Petrov (777) reaction spammer",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			mockAPI := &mocks.TbAPIMock{
+				SendFunc:    func(c tbapi.Chattable) (tbapi.Message, error) { return tbapi.Message{}, nil },
+				RequestFunc: func(c tbapi.Chattable) (*tbapi.APIResponse, error) { return &tbapi.APIResponse{Ok: true}, nil },
+			}
+			adm := &admin{
+				tbAPI: mockAPI,
+				bot: &mocks.BotMock{
+					UpdateHamFunc:       func(msg string) error { return nil },
+					AddApprovedUserFunc: func(id int64, name string) error { return nil },
+				},
+				locator: &mocks.LocatorMock{
+					SpamFunc: func(ctx context.Context, userID int64) (storage.SpamData, bool) {
+						return storage.SpamData{}, false
+					},
+				},
+				primChatID: 123, adminChatID: 456, softBan: true,
+				trainingMode: tt.training, dry: tt.dry, restoreMsg: tt.restoreMsg,
+			}
+			query := &tbapi.CallbackQuery{
+				ID:      "test-callback-id",
+				Data:    tt.data,
+				Message: &tbapi.Message{MessageID: 789, Chat: tbapi.Chat{ID: 456}, Text: tt.report},
+				From:    &tbapi.User{UserName: "admin", ID: 111},
+			}
+
+			require.NoError(t, adm.callbackUnbanConfirmed(query))
+
+			var reposts []tbapi.MessageConfig
+			for _, call := range mockAPI.SendCalls() {
+				if mc, ok := call.C.(tbapi.MessageConfig); ok && mc.ChatID == 123 {
+					reposts = append(reposts, mc)
+				}
+			}
+			if !tt.wantRepost {
+				assert.Empty(t, reposts, "nothing may be posted to the primary chat")
+				return
+			}
+			require.Len(t, reposts, 1)
+			assert.Equal(t, tbapi.ModeMarkdown, reposts[0].ParseMode)
+			for _, s := range tt.wantIn {
+				assert.Contains(t, reposts[0].Text, s)
+			}
+			for _, s := range tt.wantNotIn {
+				assert.NotContains(t, reposts[0].Text, s)
+			}
+		})
+	}
+}
+
+func TestAdmin_callbackUnbanConfirmedRestoreSendError(t *testing.T) {
+	mockAPI := &mocks.TbAPIMock{
+		SendFunc: func(c tbapi.Chattable) (tbapi.Message, error) {
+			if mc, ok := c.(tbapi.MessageConfig); ok && mc.ChatID == 123 {
+				return tbapi.Message{}, assert.AnError
+			}
+			return tbapi.Message{}, nil
+		},
+		RequestFunc: func(c tbapi.Chattable) (*tbapi.APIResponse, error) { return &tbapi.APIResponse{Ok: true}, nil },
+	}
+	adm := &admin{
+		tbAPI: mockAPI,
+		bot: &mocks.BotMock{
+			UpdateHamFunc:       func(msg string) error { return nil },
+			AddApprovedUserFunc: func(id int64, name string) error { return nil },
+		},
+		locator: &mocks.LocatorMock{
+			SpamFunc: func(ctx context.Context, userID int64) (storage.SpamData, bool) { return storage.SpamData{}, false },
+		},
+		primChatID: 123, adminChatID: 456, softBan: true, restoreMsg: "sorry",
+	}
+	query := &tbapi.CallbackQuery{
+		ID:      "test-callback-id",
+		Data:    "777:999",
+		Message: &tbapi.Message{MessageID: 789, Chat: tbapi.Chat{ID: 456}, Text: "restricted Ivan Petrov (777)\n\nhello"},
+		From:    &tbapi.User{UserName: "admin", ID: 111},
+	}
+
+	err := adm.callbackUnbanConfirmed(query)
+	require.Error(t, err, "a failed repost must reach the admin chat as an error")
+	assert.Contains(t, err.Error(), "unbanned user 777")
+
+	unbanned := false
+	for _, call := range mockAPI.RequestCalls() {
+		if _, ok := call.C.(tbapi.RestrictChatMemberConfig); ok {
+			unbanned = true
+		}
+	}
+	assert.True(t, unbanned, "the unban itself happens before the repost")
+}
